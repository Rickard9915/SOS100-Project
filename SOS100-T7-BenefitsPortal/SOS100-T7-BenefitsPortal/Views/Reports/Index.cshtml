@using SOS100_T7_BenefitsPortal.Services
@{
    ViewData["Title"] = "Rapporter";
    var benefitReport = ViewBag.BenefitReport as List<BenefitReportItem> ?? new List<BenefitReportItem>();
    var periodReport = ViewBag.PeriodReport as List<PeriodReportItem> ?? new List<PeriodReportItem>();
}

<h1 class="mb-4 page-title">Rapporter</h1>

<h2 class="h5 mb-3" style="color: var(--deep-space-blue);">Statistik per förmån</h2>
<div class="table-responsive mb-5">
    <table class="table" style="background-color: white; border-radius: 10px; overflow: hidden;">
        <thead style="background-color: var(--deep-space-blue); color: var(--vanilla-custard);">
            <tr>
                <th>Förmån</th>
                <th>Ansökningar</th>
                <th>Godkända</th>
                <th>Avslagna</th>
                <th>Väntande</th>
                <th>Total kostnad</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in benefitReport)
            {
                <tr style="border-color: rgba(0,48,73,0.08);">
                    <td style="color: var(--deep-space-blue); font-weight: 500;">@item.BenefitName</td>
                    <td>@item.TotalApplications</td>
                    <td><span class="badge badge-approved px-2">@item.ApprovedCount</span></td>
                    <td><span class="badge badge-rejected px-2">@item.RejectedCount</span></td>
                    <td><span class="badge badge-pending px-2">@item.PendingCount</span></td>
                    <td style="color: var(--deep-space-blue); font-weight: 600;">
                        @item.TotalApprovedValue.ToString("C", new System.Globalization.CultureInfo("sv-SE"))
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<h2 class="h5 mb-3" style="color: var(--deep-space-blue);">Statistik per period</h2>
<div class="table-responsive mb-4">
    <table class="table" style="background-color: white; border-radius: 10px; overflow: hidden;">
        <thead style="background-color: var(--vivid-tangerine); color: white;">
            <tr>
                <th>Period</th>
                <th>Ansökningar</th>
                <th>Godkända</th>
                <th>Avslagna</th>
                <th>Total kostnad</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in periodReport)
            {
                <tr style="border-color: rgba(0,48,73,0.08);">
                    <td style="color: var(--deep-space-blue); font-weight: 500;">@item.Period</td>
                    <td>@item.TotalApplications</td>
                    <td><span class="badge badge-approved px-2">@item.ApprovedCount</span></td>
                    <td><span class="badge badge-rejected px-2">@item.RejectedCount</span></td>
                    <td style="color: var(--deep-space-blue); font-weight: 600;">
                        @item.TotalApprovedValue.ToString("C", new System.Globalization.CultureInfo("sv-SE"))
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<a asp-controller="Home" asp-action="Index" class="btn"
   style="border: 1px solid var(--deep-space-blue); color: var(--deep-space-blue);">&larr; Tillbaka</a>
