@using SOS100_T7_BenefitsPortal.Services
@{
    ViewData["Title"] = "Rapporter";
    var benefitReport = ViewBag.BenefitReport as List<BenefitReportItem> ?? new List<BenefitReportItem>();
    var periodReport = ViewBag.PeriodReport as List<PeriodReportItem> ?? new List<PeriodReportItem>();
}

<h1 class="mb-4">Rapporter</h1>

<h2 class="h5 mb-3">Statistik per förmån</h2>
<div class="table-responsive mb-5">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Förmån</th>
                <th>Ansökningar</th>
                <th>Godkända</th>
                <th>Avslagna</th>
                <th>Väntande</th>
                <th>Total kostnad</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in benefitReport)
            {
                <tr>
                    <td>@item.BenefitName</td>
                    <td>@item.TotalApplications</td>
                    <td>@item.ApprovedCount</td>
                    <td>@item.RejectedCount</td>
                    <td>@item.PendingCount</td>
                    <td>@item.TotalApprovedValue.ToString("C", new System.Globalization.CultureInfo("sv-SE"))</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<h2 class="h5 mb-3">Statistik per period</h2>
<div class="table-responsive mb-4">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Period</th>
                <th>Ansökningar</th>
                <th>Godkända</th>
                <th>Avslagna</th>
                <th>Total kostnad</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in periodReport)
            {
                <tr>
                    <td>@item.Period</td>
                    <td>@item.TotalApplications</td>
                    <td>@item.ApprovedCount</td>
                    <td>@item.RejectedCount</td>
                    <td>@item.TotalApprovedValue.ToString("C", new System.Globalization.CultureInfo("sv-SE"))</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">&larr; Tillbaka</a>
