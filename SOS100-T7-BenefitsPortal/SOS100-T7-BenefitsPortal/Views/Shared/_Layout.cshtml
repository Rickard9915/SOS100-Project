<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Medarbetarförmånsportal</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/SOS100_T7_BenefitsPortal.styles.css" asp-append-version="true"/>
    <style>
        :root {
            --deep-space-blue: #003049;
            --flag-red: #d62828;
            --vivid-tangerine: #f77f00;
            --sunflower-gold: #fcbf49;
            --vanilla-custard: #eae2b7;
        }

        body {
            background-color: var(--vanilla-custard);
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        /* Header */
        .portal-header {
            background-color: var(--deep-space-blue);
            box-shadow: 0 2px 8px rgba(0,0,0,0.25);
        }

        .portal-brand {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--vanilla-custard) !important;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .portal-brand svg {
            width: 22px;
            height: 22px;
        }

        /* Nav tabs */
        .portal-nav .nav-link {
            color: rgba(234,226,183,0.8) !important;
            font-size: 0.9rem;
            font-weight: 500;
            padding: 6px 14px;
            border-radius: 6px;
            transition: background 0.15s, color 0.15s;
        }

        .portal-nav .nav-link:hover {
            background-color: var(--vivid-tangerine);
            color: white !important;
        }

        .portal-nav .nav-link.active {
            background-color: var(--sunflower-gold);
            color: var(--deep-space-blue) !important;
            font-weight: 600;
        }

        /* Role badge */
        .role-badge {
            font-size: 0.75rem;
            padding: 3px 10px;
            border-radius: 12px;
            font-weight: 500;
        }

        .role-badge.employee { background: var(--sunflower-gold); color: var(--deep-space-blue); }
        .role-badge.hr       { background: var(--vivid-tangerine); color: white; }
        .role-badge.finance  { background: rgba(255,255,255,0.15); color: var(--vanilla-custard); border: 1px solid rgba(234,226,183,0.4); }
        .role-badge.admin    { background: var(--flag-red); color: white; }

        /* User info */
        .portal-user {
            color: rgba(234,226,183,0.9);
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .user-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: var(--vivid-tangerine);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 0.8rem;
            color: white;
        }

        /* Cards */
        .benefit-card {
            border: 1px solid rgba(0,48,73,0.15);
            border-radius: 10px;
            transition: box-shadow 0.2s, transform 0.2s;
            background: white;
        }

        .benefit-card:hover {
            box-shadow: 0 4px 16px rgba(0,48,73,0.15);
            transform: translateY(-2px);
        }

        .benefit-icon {
            width: 44px;
            height: 44px;
            border-radius: 10px;
            background-color: var(--sunflower-gold);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--deep-space-blue);
            font-size: 1.3rem;
        }

        /* Status badges */
        .badge-pending  { background-color: var(--sunflower-gold); color: var(--deep-space-blue); }
        .badge-approved { background-color: var(--deep-space-blue); color: var(--vanilla-custard); }
        .badge-rejected { background-color: var(--flag-red); color: white; }

        /* Stat cards */
        .stat-card {
            border: 1px solid rgba(0,48,73,0.15);
            border-radius: 10px;
            background: white;
            padding: 20px;
        }

        .stat-card .stat-number {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--deep-space-blue);
        }

        .stat-card .stat-label {
            font-size: 0.8rem;
            color: #6c757d;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* Buttons */
        .btn-portal {
            background-color: var(--flag-red);
            color: white;
            border: none;
            border-radius: 7px;
            font-weight: 500;
        }

        .btn-portal:hover {
            background-color: #b71c1c;
            color: white;
        }

        /* Page title */
        .page-title {
            font-size: 1.4rem;
            font-weight: 600;
            color: var(--deep-space-blue);
        }

        /* Logout link */
        .portal-logout {
            color: rgba(234,226,183,0.8) !important;
            font-size: 0.85rem;
            text-decoration: none;
            padding: 5px 10px;
            border-radius: 6px;
            transition: background 0.15s;
        }

        .portal-logout:hover {
            background: var(--flag-red);
            color: white !important;
        }

        /* Footer */
        footer {
            border-color: rgba(0,48,73,0.2) !important;
        }

        footer small {
            color: var(--deep-space-blue) !important;
            opacity: 0.6;
        }
    </style>
</head>
<body>

<header class="portal-header mb-4">
    <div class="container-fluid px-4">
        <nav class="navbar navbar-expand-sm py-2">

            <!-- Brand -->
            <a class="portal-brand me-4" asp-controller="Home" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
                    <polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
                Medarbetarförmånsportal
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#portalNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="portalNav">

                @* Rollbaserad navigation *@
                @if (User.Identity?.IsAuthenticated == true)
                {
                    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Employee";

                    <ul class="navbar-nav portal-nav flex-grow-1 gap-1">
                        @if (role == "Employee")
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Benefits" ? "active" : "")"
                                   asp-controller="Benefits" asp-action="Index">Förmåner</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Applications" ? "active" : "")"
                                   asp-controller="Applications" asp-action="Index">Mina ansökningar</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Notifications" ? "active" : "")"
                                   asp-controller="Notifications" asp-action="Index">Meddelanden</a>
                            </li>
                        }
                        else if (role == "HR")
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Benefits" ? "active" : "")"
                                   asp-controller="Benefits" asp-action="Index">Hantera förmåner</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Applications" ? "active" : "")"
                                   asp-controller="Applications" asp-action="Index">Ansökningar</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")"
                                   asp-controller="Reports" asp-action="Index">Rapporter</a>
                            </li>
                        }
                        else if (role == "Finance")
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")"
                                   asp-controller="Reports" asp-action="Index">Rapporter</a>
                            </li>
                        }
                        else if (role == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Benefits" ? "active" : "")"
                                   asp-controller="Benefits" asp-action="Index">Förmåner</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Applications" ? "active" : "")"
                                   asp-controller="Applications" asp-action="Index">Ansökningar</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")"
                                   asp-controller="Reports" asp-action="Index">Rapporter</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Notifications" ? "active" : "")"
                                   asp-controller="Notifications" asp-action="Index">Meddelanden</a>
                            </li>
                        }
                    </ul>

                    <!-- Inloggad användare -->
                    <div class="portal-user ms-auto gap-2">
                        <div class="user-avatar">
                            @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "?")
                        </div>
                        <span class="d-none d-md-inline">@User.Identity.Name</span>
                        <span class="role-badge @role.ToLower()">@role</span>
                        <a class="portal-logout ms-2" asp-controller="Account" asp-action="Logout">Logga ut</a>
                    </div>
                }
                else
                {
                    <ul class="navbar-nav portal-nav flex-grow-1"></ul>
                    <a class="btn btn-sm btn-light ms-auto" asp-controller="Account" asp-action="Login">Logga in</a>
                }
            </div>
        </nav>
    </div>
</header>

<div class="container-fluid px-4">
    <main role="main" class="pb-4">
        @RenderBody()
    </main>
</div>


<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
