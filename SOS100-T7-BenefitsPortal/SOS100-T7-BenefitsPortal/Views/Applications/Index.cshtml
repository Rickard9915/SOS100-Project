@model List<SOS100_T7_BenefitsPortal.Services.ApplicationDto>

@{
    ViewData["Title"] = "Ansökningar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Ansökningar</h1>
    <a asp-action="Create" class="btn btn-primary">Ny ansökan</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Det finns inga ansökningar ännu.
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
        <tr>
            <th>ID</th>
            <th>Anställd</th>
            <th>Förmån-ID</th>
            <th>Status</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var application in Model)
        {
            <tr>
                <td>@application.Id</td>
                <td>@application.EmployeeName</td>
                <td>@application.BenefitId</td>
                <td>@application.Status</td>
            </tr>
        }
        </tbody>
    </table>
}