@{
    ViewData["Title"] = "Ansök om förmån";
    var benefitId = ViewBag.BenefitId as int?;
}

<div class="mb-3">
    @if (benefitId.HasValue)
    {
        <a asp-controller="Benefits" asp-action="Details" asp-route-id="@benefitId"
           class="text-decoration-none">&larr; Tillbaka till förmånen</a>
    }
    else
    {
        <a asp-action="Index" class="text-decoration-none">&larr; Tillbaka till ansökningar</a>
    }
</div>

<h1 class="mb-4">Ansök om förmån</h1>

<form asp-action="Create" method="post" class="card p-4 shadow-sm" style="max-width: 600px;">
    <div class="mb-3">
        <label for="employeeName" class="form-label">Ditt namn</label>
        <input type="text" id="employeeName" name="employeeName" class="form-control" required />
    </div>

    <div class="mb-3">
        <label for="benefitId" class="form-label">Förmån-ID</label>
        <input type="number" id="benefitId" name="benefitId" class="form-control" value="@(benefitId ?? 0)" required />
    </div>

    <button type="submit" class="btn btn-primary">Skicka ansökan</button>
</form>